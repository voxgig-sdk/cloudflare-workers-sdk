# Entity: worker

main: kit: entity: worker: {

  alias: field: {}

  fields: {
    auto_build: {
      h: "Auto Build"
      n: "auto_build"
      r: false
      sh: "Whether pushes to the git branch build this Preview."
      t: "`$BOOLEAN`"
    }
    auto_delete: {
      h: "Auto Delete"
      n: "auto_delete"
      r: false
      sh: "Whether deleting the git branch also deletes this Preview."
      t: "`$BOOLEAN`"
    }
    branch: {
      h: "Branch"
      n: "branch"
      r: false
      sh: "Git branch name (required if commit_hash not provided)"
      t: "`$ANY`"
    }
    commit_hash: {
      h: "Commit Hash"
      n: "commit_hash"
      r: false
      sh: "Git commit hash (required if branch not provided)"
      t: "`$ANY`"
    }
    errors: {
      h: "Errors"
      n: "errors"
      r: true
      t: "`$ARRAY`"
    }
    git_repository: {
      h: "Git Repository"
      n: "git_repository"
      op: {
        patch: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      sh: "Git repository settings to update"
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    messages: {
      h: "Messages"
      n: "messages"
      r: true
      t: "`$ARRAY`"
    }
    previews_base_config: {
      h: "Previews Base Config"
      n: "previews_base_config"
      op: {
        patch: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      sh: "Build and deploy settings when creating a Worker build configuration"
      t: "`$OBJECT`"
    }
    previews_enabled: {
      h: "Previews Enabled"
      n: "previews_enabled"
      op: {
        patch: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Whether Previews are enabled for this Worker"
      t: "`$BOOLEAN`"
    }
    production_settings: {
      h: "Production Settings"
      n: "production_settings"
      op: {
        patch: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      sh: "Build and deploy settings when creating a Worker build configuration"
      t: "`$OBJECT`"
    }
    result: {
      h: "Result"
      n: "result"
      op: {
        list: {
          req: false
          type: "`$OBJECT`"
        }
        load: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      sh: "A single Preview of a Worker, with the build settings it currently uses."
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 4
      }
    }
    result_info: {
      h: "Result Info"
      n: "result_info"
      r: false
      t: "`$OBJECT`"
    }
    script_tag: {
      h: "Script Tag"
      n: "script_tag"
      r: true
      sh: "System-generated tag of the Worker."
      t: "`$STRING`"
    }
    seed_repo: {
      h: "Seed Repo"
      n: "seed_repo"
      r: false
      sh: "Optional repository and file overrides used to seed this build."
      t: "`$ANY`"
    }
    settings: {
      h: "Settings"
      n: "settings"
      r: false
      sh: "Partial build settings for updating a Worker build configuration"
      t: "`$OBJECT`"
    }
    success: {
      h: "Success"
      n: "success"
      r: true
      sh: "Whether the API call was successful."
      t: "`$BOOLEAN`"
    }
  }

