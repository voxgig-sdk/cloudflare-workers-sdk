# API Information


main: {
  kit: {
    info: {
      description: "Cloudflare Workers: serverless functions, KV namespaces, Durable Objects, builds, browser rendering, containers, Hyperdrive, Pipelines, secrets, workflows, scripts, routes, tails, and deployments."
      license: {
        name: "BSD-3-Clause"
        url: "https://opensource.org/licenses/BSD-3-Clause"
      }
      security: {
        in: "header"
        name: "X-Auth-Email"
        prefix: ""
        scheme: "api_email"
        type: "apiKey"
      }
      servers: [
        {
          description: "Client API"
          url: "https://api.cloudflare.com/client/v4"
        }
      ]
      summary: "Cloudflare Workers: serverless functions, KV namespaces, Durable Objects, builds, browser rendering, containers, Hyperdrive, Pipelines, secrets, workflows, scripts, routes, tails, and deployments."
      title: "Cloudflare Workers"
      version: "4.0.0"
      website: "https://cloudflare.com"
    }
  }
}

