# BasicWorkerFlow

main: kit: flow: BasicWorkerFlow:
{
  entity: "worker",
  kind: "basic",
  name: "BasicWorkerFlow",
  step: [
    {
      i: {
        ref: "worker_ref01"
      }

      m: {
        account_id: "account01",
        preview_id: "preview01",
        script_tag: "script_tag01",
        worker_id: "worker01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01",
        external_script_id: "external_script01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "worker_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "worker_ref01",
        srcdatavar: "worker_ref01_data",
        suffix: "_up0",
        textfield: "script_tag"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-worker_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "worker_ref01",
        srcdatavar: "worker_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "worker01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-worker_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "worker_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "worker01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01",
        external_script_id: "external_script01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "worker_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWorkerFlow"
}