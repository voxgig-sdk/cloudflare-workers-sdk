# BasicIssueFlow

main: kit: flow: BasicIssueFlow:
{
  entity: "issue",
  kind: "basic",
  name: "BasicIssueFlow",
  step: [
    {
      i: {
        ref: "issue_ref01"
      }

      m: {
        account_id: "account01",
        group_id: "group01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "issue_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "issue_ref01",
        srcdatavar: "issue_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-issue_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "issue_ref01",
        srcdatavar: "issue_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "issue01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-issue_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "issue_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "issue01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "issue_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIssueFlow"
}