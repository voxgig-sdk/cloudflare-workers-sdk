# BasicSettingFlow

main: kit: flow: BasicSettingFlow:
{
  entity: "setting",
  kind: "basic",
  name: "BasicSettingFlow",
  step: [
    {
      m: {
        account_id: "account01",
        environment_name: "environment_name01",
        service_id: "service01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "setting_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01",
        service_id: "service01"
      }

      i: {
        ref: "setting_ref01",
        srcdatavar: "setting_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSettingFlow"
}