# BasicSecretsStoreStoreFlow

main: kit: flow: BasicSecretsStoreStoreFlow:
{
  entity: "secrets_store_store",
  kind: "basic",
  name: "BasicSecretsStoreStoreFlow",
  step: [
    {
      i: {
        ref: "secrets_store_store_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      i: {
        ref: "secrets_store_store_ref01",
        srcdatavar: "secrets_store_store_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "secrets_store_store01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secrets_store_store_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretsStoreStoreFlow"
}