# BasicVersionFlow

main: kit: flow: BasicVersionFlow:
{
  entity: "version",
  kind: "basic",
  name: "BasicVersionFlow",
  step: [
    {
      i: {
        ref: "version_ref01"
      }

      m: {
        account_id: "account01",
        worker_id: "worker01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01",
        worker_id: "worker01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "version_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "version_ref01",
        srcdatavar: "version_ref01_data",
        suffix: "_up0",
        textfield: "compatibility_date"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-version_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "version_ref01",
        srcdatavar: "version_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "version01",
        worker_id: "worker01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-version_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "version_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "version01",
        worker_id: "worker01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01",
        worker_id: "worker01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "version_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVersionFlow"
}