# BasicSecretFlow

main: kit: flow: BasicSecretFlow:
{
  entity: "secret",
  kind: "basic",
  name: "BasicSecretFlow",
  step: [
    {
      i: {
        ref: "secret_ref01"
      }

      m: {
        account_id: "account01",
        store_id: "store01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01",
        store_id: "store01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "secret_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01",
        store_id: "store01"
      }

      i: {
        ref: "secret_ref01",
        srcdatavar: "secret_ref01_data",
        suffix: "_up0",
        textfield: "comment"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "secret_ref01",
        srcdatavar: "secret_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "secret01",
        store_id: "store01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "secret_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "secret01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01",
        store_id: "store01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "secret_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretFlow"
}