# BasicWorkerEnvironmentFlow

main: kit: flow: BasicWorkerEnvironmentFlow:
{
  entity: "worker_environment",
  kind: "basic",
  name: "BasicWorkerEnvironmentFlow",
  step: [
    {
      i: {
        ref: "worker_environment_ref01",
        srcdatavar: "worker_environment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "worker_environment01",
        service_id: "service01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-worker_environment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWorkerEnvironmentFlow"
}