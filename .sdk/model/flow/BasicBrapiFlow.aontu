# BasicBrapiFlow

main: kit: flow: BasicBrapiFlow:
{
  entity: "brapi",
  kind: "basic",
  name: "BasicBrapiFlow",
  step: [
    {
      i: {
        ref: "brapi_ref01"
      }

      m: {
        account_id: "account01",
        browser_id: "browser01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01",
        browser_id: "browser01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "brapi_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "brapi_ref01",
        srcdatavar: "brapi_ref01_data",
        suffix: "_up0",
        textfield: "Browser"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-brapi_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "brapi_ref01",
        srcdatavar: "brapi_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "brapi01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-brapi_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "brapi_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "brapi01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01",
        browser_id: "browser01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "brapi_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBrapiFlow"
}