# BasicBuildFlow

main: kit: flow: BasicBuildFlow:
{
  entity: "build",
  kind: "basic",
  name: "BasicBuildFlow",
  step: [
    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "build_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "build_ref01",
        srcdatavar: "build_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-build_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "build_ref01",
        srcdatavar: "build_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "build01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-build_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBuildFlow"
}