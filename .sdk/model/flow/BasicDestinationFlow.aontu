# BasicDestinationFlow

main: kit: flow: BasicDestinationFlow:
{
  entity: "destination",
  kind: "basic",
  name: "BasicDestinationFlow",
  step: [
    {
      i: {
        ref: "destination_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "destination_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "destination_ref01",
        srcdatavar: "destination_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-destination_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "destination_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "destination01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "destination_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDestinationFlow"
}